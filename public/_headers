# Prevent MIME sniffing from promoting model-generated artifacts (raw-l*.txt / output.json) to HTML.
/*
  X-Content-Type-Options: nosniff

# Keep raw model-generated HTML in a unique origin, even when opened directly.
/:theme/:model/
  Content-Security-Policy: sandbox allow-scripts
  Referrer-Policy: no-referrer

/:theme/:model/index.html
  Content-Security-Policy: sandbox allow-scripts
  Referrer-Policy: no-referrer

/pr-triage/:model/output
  Content-Security-Policy: sandbox allow-scripts
  Referrer-Policy: no-referrer

/pr-triage/:model/output.html
  Content-Security-Policy: sandbox allow-scripts
  Referrer-Policy: no-referrer

/json-ladder/:model/output
  Content-Security-Policy: sandbox allow-scripts
  Referrer-Policy: no-referrer

/json-ladder/:model/output.html
  Content-Security-Policy: sandbox allow-scripts
  Referrer-Policy: no-referrer
